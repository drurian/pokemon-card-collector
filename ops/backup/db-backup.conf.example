# Copy to /etc/db-backup.conf and chmod 600.

# App env file defaults to .env.prod (auto-discovered if APP_ENV_BASE_DIR is unset).
# Set APP_ENV_BASE_DIR when you want deterministic relative resolution.
# APP_ENV_BASE_DIR can be absolute or relative to /etc (config dir).
# APP_ENV_BASE_DIR=/opt/pokemon-collector
APP_ENV_FILE=.env.prod

# Required
DB_ENGINE=mysql
MYSQL_DUMP_MODE=auto

# Docker MySQL mode settings (used when MYSQL_DUMP_MODE=docker or auto).
DOCKER_DB_SERVICE=db
# DOCKER_COMPOSE_BASE_DIR=/path/to/app/root
DOCKER_COMPOSE_FILE=docker-compose.prod.yml
# DOCKER_COMPOSE_ENV_FILE=.env.prod

# Optional DB_* overrides.
# Leave these commented to use values from APP_ENV_FILE.
# DB_NAME=pokemon_collector
# DB_USER=backup_user
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Local backup behavior
BACKUP_DIR=/var/backups/db
RETENTION_DAYS=14
# Optional count cap. Leave empty to keep all backups within RETENTION_DAYS.
RETENTION_COUNT=
COMPRESSION_LEVEL=6
LOCK_FILE=/var/lock/db-backup.lock
LOG_TAG=db-backup

# Upload behavior: none | cloud
UPLOAD_TARGET=none

# Required only when UPLOAD_TARGET=cloud
# Example remote path:
#   CLOUD_REMOTE=hetzner-obj
#   CLOUD_PATH=database-backups/pokemon-collector
CLOUD_REMOTE=
CLOUD_PATH=
